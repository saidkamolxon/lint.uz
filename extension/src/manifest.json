{
  "manifest_version": 3,
  "name": "lint.one",
  "short_name": "lint",
  "version": "0.2.6",
  "description": "Open JSON, XML, YAML, CSV, logs, PDFs, SQLite and audio from any page in lint.one. Nothing you open leaves your browser.",
  "homepage_url": "https://lint.one/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "lint.one",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "optional_permissions": ["tabCapture"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://lint.one/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "omnibox": { "keyword": "lint" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open the lint.one menu"
    }
  }
}
