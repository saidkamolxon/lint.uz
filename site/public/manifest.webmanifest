{
  "id": "/",
  "name": "lint.one",
  "short_name": "lint.one",
  "description": "Read JSON, XML, YAML, CSV, PDF, logs, SQLite and audio files in your browser. Nothing you open leaves your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FBFBFC",
  "theme_color": "#1A1D23",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "JSON", "url": "/json/", "icons": [{ "src": "/json/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "PDF", "url": "/pdf/", "icons": [{ "src": "/pdf/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Logs", "url": "/log/", "icons": [{ "src": "/log/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "CSV", "url": "/csv/", "icons": [{ "src": "/csv/favicon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ],
  "file_handlers": [
    { "action": "/json/", "accept": { "application/json": [".json", ".jsonc", ".geojson"] } },
    { "action": "/xml/", "accept": { "application/xml": [".xml", ".xsd", ".xsl", ".xslt", ".rss", ".atom", ".kml", ".gpx", ".plist"] } },
    { "action": "/yaml/", "accept": { "application/yaml": [".yaml", ".yml"] } },
    { "action": "/csv/", "accept": { "text/csv": [".csv", ".tsv", ".psv"] } },
    { "action": "/pdf/", "accept": { "application/pdf": [".pdf"] } },
    { "action": "/log/", "accept": { "text/plain": [".log", ".txt", ".out", ".err", ".jsonl", ".ndjson"] } },
    { "action": "/audio/", "accept": { "audio/*": [".mp3", ".wav", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".aif", ".aiff"] } },
    { "action": "/sqlite/", "accept": { "application/vnd.sqlite3": [".db", ".sqlite", ".sqlite3", ".db3", ".s3db", ".sl3", ".gpkg", ".mbtiles"] } }
  ]
}
