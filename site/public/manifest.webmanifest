{
  "id": "/",
  "name": "lint",
  "short_name": "lint",
  "description": "Read JSON, XML, YAML, CSV, PDF, logs, SQLite, Parquet, .env and audio files in your browser. Nothing you open leaves your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FBFBFC",
  "theme_color": "#1A1D23",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "JSON", "url": "/json/", "icons": [{ "src": "/icons/file-json.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "YAML", "url": "/yaml/", "icons": [{ "src": "/icons/file-yaml.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "CSV", "url": "/csv/", "icons": [{ "src": "/icons/file-csv.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "ENV", "url": "/env/", "icons": [{ "src": "/icons/file-env.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "LOG", "url": "/log/", "icons": [{ "src": "/icons/file-log.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "XML", "url": "/xml/", "icons": [{ "src": "/icons/file-xml.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "SQLite", "url": "/sqlite/", "icons": [{ "src": "/icons/file-sqlite.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "PDF", "url": "/pdf/", "icons": [{ "src": "/icons/file-pdf.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "Parquet", "url": "/parquet/", "icons": [{ "src": "/icons/file-parquet.png", "sizes": "256x256", "type": "image/png" }] },
    { "name": "Audio", "url": "/audio/", "icons": [{ "src": "/icons/file-audio.png", "sizes": "256x256", "type": "image/png" }] }
  ],
  "file_handlers": [
    { "action": "/json/", "accept": { "application/json": [".json", ".jsonc", ".geojson"] }, "icons": [{ "src": "/icons/file-json.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/xml/", "accept": { "application/xml": [".xml", ".xsd", ".xsl", ".xslt", ".rss", ".atom", ".kml", ".gpx", ".plist"] }, "icons": [{ "src": "/icons/file-xml.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/yaml/", "accept": { "application/yaml": [".yaml", ".yml"] }, "icons": [{ "src": "/icons/file-yaml.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/csv/", "accept": { "text/csv": [".csv", ".tsv", ".psv"] }, "icons": [{ "src": "/icons/file-csv.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/pdf/", "accept": { "application/pdf": [".pdf"] }, "icons": [{ "src": "/icons/file-pdf.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/log/", "accept": { "text/plain": [".log", ".txt", ".out", ".err", ".jsonl", ".ndjson"] }, "icons": [{ "src": "/icons/file-log.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/audio/", "accept": { "audio/*": [".mp3", ".wav", ".flac", ".ogg", ".oga", ".opus", ".m4a", ".aac", ".aif", ".aiff"] }, "icons": [{ "src": "/icons/file-audio.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/sqlite/", "accept": { "application/vnd.sqlite3": [".db", ".sqlite", ".sqlite3", ".db3", ".s3db", ".sl3", ".gpkg", ".mbtiles"] }, "icons": [{ "src": "/icons/file-sqlite.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/parquet/", "accept": { "application/vnd.apache.parquet": [".parquet", ".parq", ".pqt"] }, "icons": [{ "src": "/icons/file-parquet.png", "sizes": "256x256", "type": "image/png" }] },
    { "action": "/env/", "accept": { "text/plain": [".env"] }, "icons": [{ "src": "/icons/file-env.png", "sizes": "256x256", "type": "image/png" }] }
  ]
}
