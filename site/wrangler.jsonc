{
  "name": "lintuz-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "lint.uz/*", "zone_name": "lint.uz" },
    { "pattern": "www.lint.uz/*", "zone_name": "lint.uz" }
  ]
}
