{
  "name": "lintuz-site",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "lint.one/*", "zone_name": "lint.one" },
    { "pattern": "www.lint.one/*", "zone_name": "lint.one" }
  ]
}
